generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}


model User {
  username String @id
  password String
  role     String @default("user")
}

model Employee {
  id                      String      @id
  name                    String      @unique
  signature               String?
  lastLogged              DateTime?   @map("last_logged")
  fullName                String?     @map("full_name")
  dob                     DateTime?
  email                   String?
  pronouns                String?
  department              String?
  title                   String?
  tshirtSize              String?     @map("tshirt_size")
  emergencyContactName    String?     @map("emergency_contact_name")
  emergencyContactPhone   String?     @map("emergency_contact_phone")
  workHours               WorkHour[]

  @@map("employees")
}

model ProjectName {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  client      String?
  siteAddress String?   @map("site_address")
  status      String    @default("active") // active | ready_to_invoice | invoiced | paid
  clientId    Int?      @map("client_id")
  clientRecord Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  receipts    Receipt[]

  @@map("project_names")
}

model Client {
  id        Int           @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  phone2    String?
  phone3    String?
  company   String?
  address   String?
  notes     String?
  source    String?       @default("manual")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  jobs      ProjectName[]

  @@map("clients")
}

model Receipt {
  id         Int         @id @default(autoincrement())
  projectId  Int         @map("project_id")
  vendor     String?
  amount     Float?
  date       DateTime?
  fileUrl    String      @map("file_url")
  fileType   String?     @map("file_type")
  fileName   String?     @map("file_name")
  uploadedBy String?     @map("uploaded_by")
  createdAt  DateTime    @default(now()) @map("created_at")

  project    ProjectName @relation(fields: [projectId], references: [id])

  @@map("receipts")
}

model WorkHour {
  id            Int       @id @default(autoincrement())
  employeeId    String    @map("employee_id")
  date          DateTime
  projects      String?
  hoursWorked   Float     @default(0) @map("hours_worked")
  location      String?
  description   String?
  signature     String?
  photos        String?   // JSON array of Vercel Blob URLs
  latitude      Float?
  longitude     Float?
  locationName  String?   @map("location_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee      Employee  @relation(fields: [employeeId], references: [id])

  @@map("WorkHours")
}